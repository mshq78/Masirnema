# Neon Postgres (set automatically by the Vercel ↔ Neon integration)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Password for the admin panel (#/admin). Server-side only. Required.
ADMIN_PASSWORD="choose-a-strong-password"

# Optional: HMAC key for participant tokens (falls back to ADMIN_PASSWORD). Keep it stable once participants exist.
PARTICIPANT_TOKEN_SECRET=""

# Analysis (admin panel): Claude API key, server-side only.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (default: claude-opus-5-5)
ANALYSIS_MODEL=""
